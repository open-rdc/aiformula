<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="screen">
          <pose>0.0 -0.0 0.5 0.0 0.0 0.0</pose>
          <static>true</static>
          
          <link name="link">
            <visual name="screen_visual">
              <geometry>
                <mesh>
                  <uri>package://simulator/world/meshes/screen.dae</uri>
                  <scale>1 1 1</scale>
                </mesh>
              </geometry>
                <material>
                    <ambient>1.0 0.0 0.0 1.0</ambient>
                    <diffuse>1.0 0.0 0.0 1.0</diffuse>
                    <specular>1.0 1.0 1.0 1.0</specular>
                    <emissive>1.0 0.0 0.0 1.0</emissive>
                </material>
            </visual>
          </link>
          <plugin
            filename="ColorControl"
            name="ignition::gazebo::ColorControl">
          </plugin>
        </model>
	    
  
</sdf>