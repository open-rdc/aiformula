<?xml version="1.0" ?>
<sdf version="1.5">
  <model name="human_robot">
  <pose>0 0 0 0 0 0</pose>

  <!-- ignition plugin -->

    <plugin
      filename="libignition-gazebo-diff-drive-system.so"
      name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_frontwheel_joint</left_joint>
      <left_joint>left_backwheel_joint</left_joint>
      <right_joint>right_frontwheel_joint</right_joint>
      <right_joint>right_backwheel_joint</right_joint>
      <wheel_separation>0.580</wheel_separation>
      <wheel_radius>0.080</wheel_radius>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>/cmd_vel_obstacle</topic>
      <odom_topic>odom</odom_topic>
    </plugin>

    <plugin
      filename="PathPublisher"
      name="ignition::gazebo::PathPublisher">
      <first_file_name>dynamic_obstacle_left</first_file_name>
      <second_file_name>dynamic_obstacle_right</second_file_name>
    </plugin>
    <plugin
      filename="FollowPath"
      name="ignition::gazebo::FollowPath">
      <robot_name>human_robot</robot_name>
      <threshold>2.0</threshold>
      <linear_vel>1.39</linear_vel>
      <p_gain>1.0</p_gain>
      <i_gain>0.0</i_gain>
      <d_gain>0.14</d_gain>
    </plugin>

    <!-- chassis -->

    <link name='body'>
      <pose relative_to='__model__'>0 0 0.15 0 0 0</pose>

      <inertial> <!--inertial properties of the link mass, inertia matix-->
        <inertia>
          <ixx>4.56667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.56667</iyy>
          <iyz>0</iyz>
          <izz>4.56667</izz>
        </inertia>
        <mass>30.0</mass>
      </inertial>

      <visual name='visual'>
        <pose>-0.0 0.0 -0.1 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>package://simulator/models/dynamic_obstacle/meshes/human_robot6.dae</uri>
            <scale>0.2 0.2 0.2</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name='collision'>
        <pose>0 0 0.15 0 0 3.14159</pose>
        <geometry>
          <box>
		<size>0.612 0.580 0.1</size>
	  </box>
        </geometry>
      </collision>
    </link>

    <!-- left wheel -->

    <link name='left_frontwheel'>
      <pose relative_to="body">0.306 0.306 0 1.57 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.04778</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.04778</iyy>
          <iyz>0</iyz>
          <izz>0.07875</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <pose>0 0 0 0 0 0</pose>
	      <geometry>
          <cylinder>
            <radius>0.080</radius>
	          <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- right wheel -->

    <link name='right_frontwheel'>
      <pose relative_to="body">0.306 -0.306 0 1.57 0 0</pose> <!--angles are in radian-->
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.04778</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.04778</iyy>
          <iyz>0</iyz>
          <izz>0.07875</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
	    <pose>0 0.0 0 0 0 0</pose>
        <geometry> 
          <cylinder>
            <radius>0.080</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- caster wheel -->

    <frame name="caster_frame" attached_to='body'>
        <pose>-0.306 0 0 0 0 0</pose>
    </frame>

    <link name='right_backwheel'>
      <pose relative_to='caster_frame'>0 -0.306 0 1.57 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <geometry>
          <cylinder>  
            <radius>0.080</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <link name='left_backwheel'>
      <pose relative_to='caster_frame'>0 0.306 0 1.57 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.04778</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.04778</iyy>
          <iyz>0</iyz>
          <izz>0.07875</izz>
        </inertia>
      </inertial>
      <collision name='collision'>
        <geometry>
          <cylinder>
            <radius>0.080</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>
    </link>

    <!-- joint config -->

    <joint name='left_frontwheel_joint' type='revolute'>
      <pose relative_to='left_frontwheel'/>
      <parent>body</parent>
      <child>left_frontwheel</child>
      <axis>
        <xyz expressed_in='__model__'>0 1 0</xyz>
        <limit>
          <effort>84.4</effort>
        </limit>
        <dynamics>
          <friction>0.9</friction>  <!-- 静止摩擦 -->
        </dynamics>
      </axis>
    </joint>

    <joint name='right_frontwheel_joint' type='revolute'>
      <pose relative_to='right_frontwheel'/>
      <parent>body</parent>
      <child>right_frontwheel</child>
      <axis>
        <xyz expressed_in='__model__'>0 1 0</xyz>
        <limit>
          <effort>84.4</effort>
        </limit>
        <dynamics>
          <friction>0.9</friction>  <!-- 静止摩擦 -->
        </dynamics>
      </axis>
    </joint>

    <joint name='right_backwheel_joint' type='revolute'>
      <pose relative_to='right_backwheel'/>
      <parent>body</parent>
      <child>right_backwheel</child>
      <axis>
        <xyz expressed_in='__model__'>0 1 0</xyz>
        <limit>
          <effort>84.4</effort>
        </limit>
        <dynamics>
          <friction>0.9</friction>  <!-- 静止摩擦 -->
        </dynamics>
      </axis>
    </joint>
    
    <joint name='left_backwheel_joint' type='revolute'>
      <pose relative_to='left_backwheel'/>
      <parent>body</parent>
      <child>left_backwheel</child>
      <axis>
        <xyz expressed_in='__model__'>0 1 0</xyz>
        <limit>
          <effort>84.4</effort>
        </limit>
        <dynamics>
          <friction>0.9</friction>  <!-- 静止摩擦 -->
        </dynamics>
      </axis>
    </joint>

    
    <!-- sensors -->
    <link name="gps_link">
      <sensor name="gps_sensor" type="navsat">
        <always_on>true</always_on>
        <update_rate>5.0</update_rate>
        <topic>obstacle/navsat</topic>
      </sensor>
    </link>
    <link name="imu_link">
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>20.0</update_rate> <!--Hz-->
        <visualize>true</visualize>
        <topic>obstacle/imu</topic>
      </sensor>
    </link>

    <joint name="gps_joint" type="fixed">
      <parent>body</parent>
      <child>gps_link</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>

    <joint name="imu_joint" type="fixed">
      <parent>body</parent>
      <child>imu_link</child>
      <pose>0.0 0.0 0.0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
      </axis>
    </joint>
    
  </model>
</sdf>
